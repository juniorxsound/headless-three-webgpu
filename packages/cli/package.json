{
  "name": "@rendergl/three-headless-cli",
  "version": "0.1.0",
  "description": "CLI for @rendergl/three-headless",
  "license": "Apache-2.0",
  "bin": {
    "rgl": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json src test",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rendergl/three-headless": "workspace:*",
    "@rendergl/three-headless-helpers": "workspace:*",
    "commander": "^13.1.0",
    "zod": "^4.1.5"
  }
}
